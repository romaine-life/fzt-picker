--- /dev/null
+++ b/frontend/picker/hidden_darwin_test.go
@@ -0,0 +1,32 @@
+package picker
+
+import (
+	"os"
+	"path/filepath"
+	"syscall"
+	"testing"
+)
+
+func TestDarwinHiddenFiles(t *testing.T) {
+	dir := t.TempDir()
+	for _, name := range []string{"shown", ".dotted", "flagged"} {
+		if err := os.Mkdir(filepath.Join(dir, name), 0o755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := syscall.Chflags(filepath.Join(dir, "flagged"), 0x8000); err != nil { // UF_HIDDEN
+		t.Fatal(err)
+	}
+	if err := os.Symlink(filepath.Join(dir, "missing"), filepath.Join(dir, "broken")); err != nil {
+		t.Fatal(err)
+	}
+
+	items := NewDirProvider(false).LoadChildren(dir)
+	if len(items) != 1 || items[0].Fields[0] != "shown" {
+		var names []string
+		for _, it := range items {
+			names = append(names, it.Fields[0])
+		}
+		t.Fatalf("got %v, want only shown", names)
+	}
+}
diff --git a/frontend/picker/hidden_windows.go b/frontend/picker/hidden_windows.go
new file mode 100644
index 0000000..4f7d461
--- /dev/null
+++ b/frontend/picker/hidden_windows.go
@@ -0,0 +1,14 @@
+package picker
+
+import "syscall"
+
+func isHiddenFile(path string) bool {
+	pathW, _ := syscall.UTF16PtrFromString(path)
+	attrs, err := syscall.GetFileAttributes(pathW)
+	if err != nil {
+		return true // can't read attributes — likely a protected system folder
+	}
+	const FILE_ATTRIBUTE_HIDDEN = 0x2
+	const FILE_ATTRIBUTE_SYSTEM = 0x4
+	return attrs&(FILE_ATTRIBUTE_HIDDEN|FILE_ATTRIBUTE_SYSTEM) != 0
+}
